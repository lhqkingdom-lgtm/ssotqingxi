{
  "version": 3,
  "sheet_order": ["chips", "pin_mux", "peripherals", "electrical", "memory"],
  "metadata_fields": ["pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
  "allow_additional_public_fields": false,
  "sheets": {
    "chips": {
      "fields": ["chip_id", "series", "core", "flash_kb", "ram_kb", "max_freq_mhz", "package_types", "voltage_min", "voltage_max", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "key": ["chip_id"],
      "required": ["chip_id", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "field_types": {
        "chip_id": ["string"], "series": ["string"], "core": ["string", "integer"],
        "flash_kb": ["number"], "ram_kb": ["number"], "max_freq_mhz": ["number"],
        "package_types": ["array_string"], "voltage_min": ["number"], "voltage_max": ["number"],
        "pdf_source_file": ["string"], "evidence_pages": ["string"], "ingested_by": ["string"],
        "ingested_at": ["iso_datetime"], "is_reviewed": ["boolean"]
      },
      "canonical_units": {"flash_kb": "KB", "ram_kb": "KB", "max_freq_mhz": "MHz", "voltage_min": "V", "voltage_max": "V"},
      "ranges": {"flash_kb": [0.001, 1048576], "ram_kb": [0.001, 1048576], "max_freq_mhz": [0.01, 1000000], "voltage_min": [-1, 20], "voltage_max": [0, 20]},
      "ordered_pairs": [["voltage_min", "voltage_max"]]
    },
    "pin_mux": {
      "fields": ["chip_id", "pin_name", "pin_number", "function_name", "is_supported", "af_code", "default_function", "constraints", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "key": ["chip_id", "pin_name", "function_name"],
      "required": ["chip_id", "pin_name", "pin_number", "function_name", "is_supported", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "field_types": {
        "chip_id": ["string"], "pin_name": ["string"], "pin_number": ["pin_designator"],
        "function_name": ["string"], "is_supported": ["boolean"], "af_code": ["string"],
        "default_function": ["string"], "constraints": ["string"], "pdf_source_file": ["string"],
        "evidence_pages": ["string"], "ingested_by": ["string"], "ingested_at": ["iso_datetime"],
        "is_reviewed": ["boolean"]
      },
      "ignored_fields": ["af_code", "constraints"]
    },
    "peripherals": {
      "fields": ["chip_id", "peripheral_type", "instance_count", "channel_count", "max_resolution", "max_frequency_mhz", "features", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "key": ["chip_id", "peripheral_type"],
      "required": ["chip_id", "peripheral_type", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "field_types": {
        "chip_id": ["string"], "peripheral_type": ["string"], "instance_count": ["number"], "channel_count": ["number"],
        "max_resolution": ["number"], "max_frequency_mhz": ["number"], "features": ["string"],
        "pdf_source_file": ["string"], "evidence_pages": ["string"], "ingested_by": ["string"],
        "ingested_at": ["iso_datetime"], "is_reviewed": ["boolean"]
      },
      "canonical_units": {"instance_count": "count", "channel_count": "count", "max_resolution": "bit", "max_frequency_mhz": "MHz"},
      "ranges": {"instance_count": [0, 10000], "channel_count": [0, 10000], "max_resolution": [0, 1024], "max_frequency_mhz": [0.01, 1000000]},
      "ignored_fields": ["features"]
    },
    "electrical": {
      "fields": ["chip_id", "param_name", "min_value", "max_value", "unit", "conditions", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "key": ["chip_id", "param_name"],
      "required": ["chip_id", "param_name", "unit", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "field_types": {
        "chip_id": ["string"], "param_name": ["string"], "min_value": ["number"],
        "max_value": ["number"], "unit": ["string"], "conditions": ["string"],
        "pdf_source_file": ["string"], "evidence_pages": ["string"], "ingested_by": ["string"],
        "ingested_at": ["iso_datetime"], "is_reviewed": ["boolean"]
      },
      "ordered_pairs": [["min_value", "max_value"]],
      "ignored_fields": ["conditions"]
    },
    "memory": {
      "fields": ["chip_id", "memory_type", "size_kb", "organization", "features", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "key": ["chip_id", "memory_type"],
      "required": ["chip_id", "memory_type", "size_kb", "pdf_source_file", "evidence_pages", "ingested_by", "ingested_at", "is_reviewed"],
      "field_types": {
        "chip_id": ["string"], "memory_type": ["string"], "size_kb": ["number"],
        "organization": ["string"], "features": ["string"], "pdf_source_file": ["string"],
        "evidence_pages": ["string"], "ingested_by": ["string"], "ingested_at": ["iso_datetime"],
        "is_reviewed": ["boolean"]
      },
      "canonical_units": {"size_kb": "KB"},
      "ranges": {"size_kb": [0.001, 1048576]},
      "ignored_fields": ["organization", "features"]
    }
  },
  "header_aliases": {
    "chip_id": ["芯片型号", "产品型号", "型号"],
    "flash": ["FLASH容量", "FLASHROM容量", "程序FLASH", "FLASH"],
    "mtp": ["MTPROM容量", "MTP容量", "MTP"],
    "external_ram": ["外部RAM", "外部SRAM", "SRAM容量", "SRAM"],
    "eeprom": ["EEPROM容量", "EEPROM"],
    "voltage": ["工作电压", "电压范围"],
    "package": ["封装形式", "封装类型", "封装"],
    "uart": ["UART数量", "UART"],
    "i2c": ["I2C数量", "I2C通道数量", "I2C"],
    "spi": ["SPI数量", "SPI"],
    "pwm": ["PWM通道数量", "16BITPWM通道数量", "PWM"],
    "adc": ["ADC通道数量", "12BITADC通道数量", "12位ADC", "ADC"],
    "touch": ["触摸按键数量", "触摸按键数", "电容式触摸按键", "TOUCHKEY"]
  },
  "value_aliases": {
    "supported": ["√", "Y", "YES", "支持", "有", "1"],
    "unsupported": ["×", "X", "--", "---", "无", "不支持", "0"]
  },
  "limits": {
    "voltage_min": [-1.0, 20.0],
    "voltage_max": [0.0, 20.0],
    "temperature": [-100.0, 200.0],
    "frequency_mhz": [0.01, 1000.0],
    "memory_kb": [0.001, 1048576.0],
    "pin_number": [1, 1000]
  }
}
