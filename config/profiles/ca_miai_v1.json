{
  "profile_version": 2,
  "profile_id": "ca_miai_v1",
  "config_version": "ca-miai-2.0.0",
  "description": "CA32/CA51/CA51M/MiAi/MJ 文字版手册。",
  "adapter": "family_extractors.ca_miai",
  "execution": {
    "default": "legacy",
    "declarative_adapter": "family_extractors.declarative"
  },
  "detection": {
    "filename_any": ["CA32", "CA51", "MiAi", "MIAI", "MJ", "SQ-CA"],
    "text_any": ["基本特性", "芯片型号", "器件型号", "管脚功能", "引脚功能"],
    "filename_weight": 10, "text_weight": 2, "minimum_score": 4, "scan_pages": 3
  },
  "dictionary": {
    "base": "../common_field_dictionary.json",
    "aliases": {"flash_kb": ["flashrom容量"], "ram_kb": ["sram容量"], "ram_external_kb": ["外部sram"]}
  },
  "model": {
    "pattern": "(?:CA(?:32|51)[FM]\\d+[A-Z0-9]*|(?:MiAi|MIAI|MJ)[-‐–—]?\\d+[A-Z0-9]*|SQ[-‐–—]?CA51F\\d+[A-Z0-9]*)",
    "concatenation_boundary": "(?<=[A-Z0-9])(?=(?:CA32F|CA51F|CA51M|MiAi-|MIAI-|MJ\\d))",
    "strip_prefixes": ["SQ-"], "skip_suffixes": ["XX"],
    "exact": [
      {"prefix": "CA32F", "min_suffix_length": 3, "require_alpha": true, "require_digit": true},
      {"prefix": "CA51F", "min_suffix_length": 3, "require_alpha": true, "require_digit": true},
      {"prefix": "CA51M", "min_suffix_length": 3, "require_alpha": true, "require_digit": true},
      {"prefix": "MIAI-", "min_suffix_length": 5, "require_alpha": true},
      {"prefix": "MJ", "min_total_length": 7, "require_alpha": true}
    ],
    "series": [
      {"kind": "prefix", "prefix": "CA32F"}, {"kind": "prefix", "prefix": "CA51F"},
      {"kind": "prefix", "prefix": "CA51M"},
      {"kind": "code", "prefix": "MiAi-", "code_length": 3, "output_prefix": "MiAi-"},
      {"kind": "code", "prefix": "MJ", "code_length": 3, "output_prefix": "MJ"}
    ],
    "aliases_file": "../chip_aliases.json"
  },
  "syntax": {
    "package_pattern": "(?:LQFP|TSSOP|SSOP|MSOP|SOP|QFN|DFN|DIP|SOT)\\s*\\d+(?:\\([^)]*\\))?",
    "pin_pattern": "(?:P\\d+\\.\\d+|P[A-Z]\\d{1,2})"
  },
  "normalization": {"function_aliases": {"IIC": "I2C", "12C": "I2C"}},
  "topologies": {
    "pipeline": ["basic_text", "model_row", "model_transposed", "pin_definition", "electrical_limits"],
    "presets": {"family_tables": "../table_presets/ca_miai_tables.json"}
  },
  "declarative": {
    "version": 1,
    "sections": [
      {
        "id": "models",
        "component": "model_matrix",
        "config": {
          "variants": [
            {
              "layout": "models_in_columns",
              "locator": {"required_all": ["flash", "sram"]},
              "fields": {
                "flash_kb": {"reducer": "max"},
                "ram_kb": {"reducer": "max"},
                "ram_external_kb": {"reducer": "max"},
                "max_freq_mhz": {"reducer": "max"},
                "operating_conditions": {},
                "package_types": {}
              }
            },
            {
              "layout": "models_in_rows",
              "locator": {"required_any": ["flash", "sram", "mtp"]},
              "model_header_any": ["芯片型号", "器件型号", "产品型号"],
              "fields": {
                "flash_kb": {"reducer": "max"},
                "ram_kb": {"reducer": "max"},
                "ram_external_kb": {"reducer": "max"},
                "ram_internal_kb": {"reducer": "max"},
                "mtp_kb": {"reducer": "max"},
                "eeprom_kb": {"reducer": "max"},
                "max_freq_mhz": {"reducer": "max"},
                "operating_voltage": {},
                "operating_temperature": {},
                "package_types": {}
              }
            },
            {
              "layout": "models_in_text_summary",
              "scan_page_count": 10,
              "require_single_model": true,
              "fields": {
                "flash_kb": {"reducer": "max", "required": true},
                "max_freq_mhz": {"reducer": "max"},
                "operating_voltage": {},
                "operating_temperature": {},
                "package_types": {"required": true}
              }
            }
          ]
        }
      },
      {
        "id": "document_memory",
        "component": "document_quantities",
        "required": false,
        "config": {
          "fields": ["ram_internal_kb", "ram_external_kb", "mtp_kb", "eeprom_kb"],
          "scan_page_count": 12,
          "association_window": 24
        }
      },
      {
        "id": "document_conditions",
        "component": "document_ranges",
        "required": false,
        "config": {
          "fields": ["operating_voltage", "operating_temperature"],
          "scan_page_count": 12
        }
      },
      {
        "id": "conditions_table",
        "component": "operating_conditions",
        "required": false,
        "config": {
          "scope": "document",
          "table_any": ["直流供电电压", "supplyvoltage", "operatingvoltage"],
          "primary_voltage_symbols": ["VDD", "VCC"],
          "temperature_any": ["工作环境温度", "工作温度", "ambienttemperature", "operatingtemperature"],
          "temperature_exclude_any": ["储存", "storage", "结温", "junction"]
        }
      },
      {
        "id": "document_peripherals",
        "component": "document_values",
        "required": false,
        "config": {
          "fields": [
            "peripheral_uart", "peripheral_i2c", "peripheral_spi",
            "peripheral_pwm", "peripheral_adc", "peripheral_touch"
          ],
          "scan_page_count": 12,
          "association_window": 12,
          "statement_any": ["支持", "内置", "集成", "最多", "channels"],
          "scope_exclude_any": ["不同型号会有不同", "depending on device", "depending on package"]
        }
      },
      {
        "id": "memory",
        "component": "memory_projection",
        "depends_on": ["models", "document_memory"],
        "config": {
          "model_section": "models",
          "mappings": [
            {"source_field": "flash_kb", "memory_type": "Flash"},
            {"source_field": "mtp_kb", "memory_type": "MTP"},
            {"source_field": "ram_kb", "memory_type": "SRAM_Total"},
            {"source_field": "ram_internal_kb", "memory_type": "SRAM_Internal", "source_section": "document_memory"},
            {"source_field": "ram_external_kb", "memory_type": "SRAM_External", "fallback_section": "document_memory"},
            {"source_field": "eeprom_kb", "memory_type": "EEPROM", "source_section": "document_memory"}
          ]
        }
      },
      {
        "id": "electrical",
        "component": "electrical_projection",
        "depends_on": ["models", "document_conditions", "conditions_table"],
        "config": {
          "model_section": "models",
          "mappings": [
            {
              "semantic": "operating_voltage",
              "param_name": "VDD",
              "unit": "V",
              "evidence_fields": ["operating_voltage", "operating_conditions"],
              "fallback_section": "document_conditions"
            },
            {
              "semantic": "operating_temperature",
              "param_name": "T_operating",
              "unit": "°C",
              "evidence_fields": ["operating_temperature", "operating_conditions"],
              "fallback_section": "conditions_table"
            }
          ]
        }
      },
      {
        "id": "peripherals",
        "component": "peripheral_projection",
        "depends_on": ["models", "document_peripherals"],
        "config": {
          "model_section": "models",
          "fallback_section": "document_peripherals",
          "fields": {
            "peripheral_uart": {"value_parser": "first_integer", "reducer": "sum"},
            "peripheral_i2c": {"value_parser": "first_integer", "reducer": "sum"},
            "peripheral_spi": {"value_parser": "first_integer", "reducer": "sum"},
            "peripheral_pwm": {"value_parser": "first_integer", "reducer": "sum", "resolution_from_label": true},
            "peripheral_adc": {
              "value_parser": "adc_instance_count",
              "reducer": "sum",
              "channel_value_parser": "adc_channel_count",
              "channel_reducer": "max",
              "bare_numeric_role": "channel_count",
              "resolution_from_label": true
            },
            "peripheral_touch": {"value_parser": "first_integer", "reducer": "sum"}
          }
        }
      },
      {
        "id": "pins",
        "component": "pin_projection",
        "depends_on": ["models"],
        "config": {
          "model_section": "models",
          "recipe_preset": "family_tables"
        }
      }
    ]
  }
}
