{
  "preset_version": 1,
  "preset_id": "stm32_feature_matrix",
  "field_dictionary_file": "../common_field_dictionary.json",
  "topology": "model_column_matrix",
  "title_any": [
    "features and peripheral counts",
    "device features and peripheral counts",
    "device features",
    "features and peripheral",
    "features and",
    "family device features"
  ],
  "locator": {
    "required_all": [],
    "required_any": ["sram", "ram", "memorydensity"]
  },
  "title_optional_when_entity_column_matches": true,
  "continuation": {
    "enabled": true,
    "match_table_number": true,
    "inherit_model_columns": true
  },
  "fields": {
    "flash_kb": {
      "match_scope": "path",
      "reducer": "first_nonempty",
      "cell_reducer": "max"
    },
    "ram_kb": {
      "match_scope": "path",
      "prefer_total_from_label": true,
      "reducer": "sum",
      "cell_reducer": "max"
    },
    "max_freq_mhz": {
      "match_scope": "path",
      "value_parser": "frequency_mhz",
      "reducer": "max"
    },
    "operating_voltage": {
      "rows": ["operatingvoltage", "standardoperatingvoltage"],
      "match_scope": "path",
      "exclude_rows": ["vdd12", "dd12", "corevoltage", "vcap"],
      "reducer": "range"
    },
    "package_types": {
      "rows": ["package", "packages"],
      "match_scope": "row",
      "exclude_rows": ["bodysize", "pitch", "ballsize", "thickness", "ballcount"],
      "reducer": "union"
    }
  },
  "peripherals": {
    "SPI": {"rows": ["spi", "spi[i2s]"], "exclude_rows": ["qspi", "quadspi", "quad-spi", "octospi", "octo-spi"], "value_parser": "first_integer", "reducer": "max"},
    "I2C": {"rows": ["i2c"], "value_parser": "first_integer", "reducer": "max"},
    "UART": {"rows": ["usart", "uart", "lpuart"], "value_parser": "sum_components", "reducer": "sum"},
    "ADC": {"rows": ["adc"], "exclude_rows": ["vref", "reference"], "match_scope": "path", "value_parser": "adc_instance_count", "reducer": "max", "channel_value_parser": "adc_channel_count", "channel_reducer": "max", "resolution_from_label": true}
  }
}
